# Sync server
PORT=8080
SYNC_API_TOKEN=TU_SYNC_API_TOKEN

# PostgreSQL local. Docker Compose reemplaza DB_HOST por host.docker.internal.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=algym
DB_USER=algym_sync
DB_PASSWORD=CAMBIA_POR_UNA_CLAVE_LOCAL_ALEATORIA

# ZKTeco / biometric device
ZK_DEVICE_IP=10.0.0.20
ZK_DEVICE_PORT=4370
ZK_DEVICE_TIMEOUT=5000
ZK_DEVICE_INPORT=5200
ZK_REGISTRY_CODE=1
ZK_SUCCESS_RETURNS=0
ZK_TIME_UTC_OFFSET=-06:00
# Mantener true durante el corte y hasta revisar la cola antes de conectar el reloj.
SYNC_COMMAND_DELIVERY_PAUSED=true

# Optional tuning
COMMAND_LOCK_MS=25000
DEVICE_RECONCILE_COOLDOWN_MS=120000
